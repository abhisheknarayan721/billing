{
  "name": "billing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/db-sync.mjs",
    "dev": "next dev",
    "build": "next build",
    "prestart": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev && node scripts/db-sync.mjs",
    "db:deploy": "node scripts/db-sync.mjs",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:pull": "prisma db pull && prisma generate",
    "db:init": "node scripts/init-db.mjs",
    "user:create": "node scripts/create-user.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:export-data": "node scripts/db-export-data.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@next/env": "16.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
